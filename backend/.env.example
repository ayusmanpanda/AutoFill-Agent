# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in ONE provider key.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
# The real .env is gitignored — never commit it.
# ---------------------------------------------------------------------------

# Provider LiteLLM routes to. Setting this explicitly avoids mis-routing model
# ids that contain a "/" (e.g. Groq's "openai/gpt-oss-120b") to OpenAI.
LLM_PROVIDER=groq

# The provider's own model id (NO extra provider prefix).
LLM_MODEL=openai/gpt-oss-120b
# Alternatives:
#   LLM_PROVIDER=groq    LLM_MODEL=openai/gpt-oss-20b   # faster, higher limits
#   LLM_PROVIDER=groq    LLM_MODEL=qwen/qwen3.6-27b     # another general option
#   LLM_PROVIDER=gemini  LLM_MODEL=gemini-1.5-flash     # Google Gemini instead

# --- Option A: Groq (recommended — fast, generous free tier) ---
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Option B: Google Gemini free tier (also supports vision later) ---
# Get a free key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Local security: the extension must send this exact value as X-Local-Token.
# Change it to any random string.
LOCAL_TOKEN=madeByAyusman
